FROM wazuh/wazuh-manager:4.14.5

USER root

# Copy SSL certificates
COPY config/wazuh_indexer_ssl_certs/root-ca-manager.pem /etc/ssl/root-ca.pem
COPY config/wazuh_indexer_ssl_certs/wazuh.manager.pem /etc/ssl/filebeat.pem
COPY config/wazuh_indexer_ssl_certs/wazuh.manager-key.pem /etc/ssl/filebeat.key

# Copy Wazuh manager configuration
COPY config/wazuh_cluster/wazuh_manager.conf /wazuh-config-mount/etc/ossec.conf

# Copy custom decoders and rules
COPY config/wazuh_cluster/decoders/llm_agent_decoder.xml /var/ossec/etc/decoders/llm_agent_decoder.xml
COPY config/wazuh_cluster/rules/llm_agent_rules.xml /var/ossec/etc/rules/llm_agent_rules.xml

RUN chmod 640 /etc/ssl/root-ca.pem /etc/ssl/filebeat.pem /etc/ssl/filebeat.key && \
    chmod 640 /var/ossec/etc/decoders/llm_agent_decoder.xml \
              /var/ossec/etc/rules/llm_agent_rules.xml 2>/dev/null || true

# Restore to the original user of the wazuh-manager base image
USER ossec
