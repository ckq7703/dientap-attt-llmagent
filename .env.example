# ==============================================================================
# CẤU HÌNH LIÊN QUAN ĐẾN ĐA NGƯỜI DÙNG (PORTS)
# ==============================================================================
# Nếu chạy nhiều Stack trên cùng host, hãy đổi các cổng này để tránh xung đột.
CHATBOT_PORT=8501
DASHBOARD_PORT=443
INDEXER_PORT=9200
MANAGER_1514_PORT=1514
MANAGER_1515_PORT=1515
MANAGER_55000_PORT=55000
MANAGER_514_UDP_PORT=514

# ==============================================================================
# CẤU HÌNH CHATBOT & MODEL (LLM)
# ==============================================================================
# Model name dùng cho LiteLLM (ví dụ: openrouter/mistralai/mistral-nemo, openai/gpt-4o, ollama/mistral-nemo)
model_name=openrouter/mistralai/mistral-nemo

# API Key cho các nhà cung cấp (bỏ comment và điền giá trị nếu dùng)
OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# OLLAMA_HOST=http://host.docker.internal:11434

# ==============================================================================
# CẤU HÌNH WAZUH
# ==============================================================================
WAZUH_API_PASSWORD=MyS3cr37P450r.*-
WAZUH_INDEXER_PASSWORD=SecretPassword
