# ==============================================================================
# CẤU HÌNH MODEL (LITELLM / OLLAMA / OPENROUTER)
# ==============================================================================
# Chọn model muốn sử dụng (bỏ comment dòng tương ứng):
#
# 1. Ollama local
# model_name="ollama/mistral-nemo"
# OLLAMA_HOST=http://host.docker.internal:11434
#
# 2. OpenRouter
# model_name="openrouter/mistralai/mistral-nemo"
# OPENROUTER_API_KEY="sk-or-v1-your-api-key-here"
#
# 3. OpenAI
# model_name="openai/gpt-4o"
# OPENAI_API_KEY="sk-your-openai-api-key-here"

model_name="ollama/mistral-nemo"
OLLAMA_HOST=http://host.docker.internal:11434

# ==============================================================================
# CẤU HÌNH LƯU TRỮ BÊN TRONG CONTAINER (không mount ra host)
# ==============================================================================
# Log của LLM Agent (Wazuh sẽ đọc từ đây nếu share volume hoặc qua syslog)
LLM_LOG_DIR=/app/logs

# SQLite database — lưu trong container
DB_PATH=/app/data/transactions.db

# ==============================================================================
# CẤU HÌNH WAZUH (kết nối trực tiếp vào Wazuh containers qua Docker network)
# ==============================================================================
# Network: single-node_default (bridge, 172.20.0.0/16)
# Hostname wazuh.manager, wazuh.indexer, wazuh.dashboard đều resolve trong network này

# Wazuh Manager REST API (port 55000)
WAZUH_HOST=wazuh.manager
WAZUH_API_URL=https://wazuh.manager:55000
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=MyS3cr37P450r.*-

# Wazuh Indexer / OpenSearch (port 9200)
WAZUH_INDEXER_URL=https://wazuh.indexer:9200
WAZUH_INDEXER_USER=admin
WAZUH_INDEXER_PASSWORD=SecretPassword

# Wazuh Dashboard (port 5601 / HTTPS 443)
WAZUH_DASHBOARD_URL=https://wazuh.dashboard:5601
